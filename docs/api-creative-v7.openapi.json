  "components": {
    "schemas": {
      "AdjustmentPreview": {
        "properties": {
          "expected_decision_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Decision Sha256"
          },
          "rap_min_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rap Min Pct"
          },
          "target_overrides": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "enum": [
                "DS",
                "strain",
                "TSR",
                "residual"
              ]
            },
            "type": "object",
            "maxProperties": 4,
            "title": "Target Overrides"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_decision_sha256"
        ],
        "title": "AdjustmentPreview"
      },
      "CaseRunRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{8,80}$",
            "title": "Request Id"
          },
          "evidence_view": {
            "type": "string",
            "enum": [
              "all",
              "complete_numeric_demo"
            ],
            "title": "Evidence View",
            "default": "all"
          },
          "rap_min_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rap Min Pct"
          },
          "adjustment_reason": {
            "type": "string",
            "maxLength": 1000,
            "title": "Adjustment Reason",
            "default": ""
          },
          "target_overrides": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "enum": [
                "DS",
                "strain",
                "TSR",
                "residual"
              ]
            },
            "type": "object",
            "maxProperties": 4,
            "title": "Target Overrides"
          },
          "based_on_decision_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Based On Decision Id"
          },
          "expected_decision_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Decision Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "CaseRunRequest"
      },
      "DraftRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{8,80}$",
            "title": "Request Id"
          },
          "origin_decision_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Origin Decision Id"
          },
          "expected_decision_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Decision Sha256"
          },
          "parent_recipe_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Parent Recipe Id"
          },
          "hypothesis_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Hypothesis Id"
          },
          "locked_fields": {
            "items": {
              "type": "string",
              "enum": [
                "oil_stone_ratio_pct",
                "nominal_component_weights"
              ]
            },
            "type": "array",
            "maxItems": 2,
            "title": "Locked Fields"
          },
          "design_intent": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Design Intent"
          },
          "research_scope_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Research Scope Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "origin_decision_id",
          "expected_decision_sha256",
          "parent_recipe_id",
          "hypothesis_id",
          "design_intent",
          "research_scope_sha256"
        ],
        "title": "DraftRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PreferenceRequest": {
        "properties": {
          "decision_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Decision Id"
          },
          "expected_decision_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Expected Decision Sha256"
          },
          "priority_order": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Priority Order"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason",
            "default": "比较相同硬要求下的指标优先顺序"
          },
          "persist": {
            "type": "boolean",
            "title": "Persist",
            "default": false
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{8,80}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision_id",
          "expected_decision_sha256",
          "priority_order"
        ],
        "title": "PreferenceRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
