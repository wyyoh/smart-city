    "/v5/design/explorations/{decision_id}/{parent_id}": {
      "get": {
        "tags": [
          "案例与协同设计"
        ],
        "summary": "Get Exploration",
        "operationId": "get_exploration_v5_design_explorations__decision_id___parent_id__get",
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Decision Id"
            }
          },
          {
            "name": "parent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Parent Id"
            }
          },
          {
            "name": "supported_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Supported Only"
            }
          },
          {
            "name": "locked_fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "enum": [
                  "oil_stone_ratio_pct",
                  "nominal_component_weights"
                ],
                "type": "string"
              },
              "default": [],
