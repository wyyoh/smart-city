  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ObservationInput": {
        "properties": {
          "recipe_id": {
            "type": "string",
            "title": "Recipe Id"
          },
          "metric": {
            "type": "string",
            "enum": [
              "DS",
              "strain",
              "TSR",
              "residual",
              "stability",
              "VV",
              "VMA",
              "flow"
            ],
            "title": "Metric"
          },
          "value": {
            "type": "number",
            "minimum": 0.0,
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "test_group": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Test Group"
          },
          "method": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Method"
          },
          "conditions": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Conditions"
          },
          "source_reference": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Source Reference"
          },
          "sample_count": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Sample Count"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 160,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "data_scope": {
            "type": "string",
            "enum": [
              "demo",
              "official"
            ],
            "title": "Data Scope",
            "default": "demo"
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recipe_id",
          "metric",
          "value",
          "unit",
          "test_group",
          "method",
          "conditions",
          "source_reference",
          "sample_count",
          "idempotency_key"
        ],
        "title": "ObservationInput"
      },
      "ReviewInput": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "title": "State"
          },
          "reviewer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Reviewer"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Note"
          },
          "conditions_confirmed": {
            "type": "boolean",
            "title": "Conditions Confirmed",
            "default": false
          },
          "use_for_recommendation": {
            "type": "boolean",
            "title": "Use For Recommendation",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "reviewer",
          "note"
        ],
        "title": "ReviewInput"
      },
      "Scenario": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "maintenance_method": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Maintenance Method"
          },
          "layer": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Layer"
          },
          "distress_type": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Distress Type"
          },
          "climate_zone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Climate Zone"
          },
          "traffic_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Traffic Level"
          },
          "targets": {
            "items": {
              "$ref": "#/components/schemas/Target"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Targets"
          },
          "candidate_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Ids"
          },
          "available_sources": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Sources"
          },
          "rap_min_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Rap Min Pct",
            "default": 0
          },
          "priority": {
            "type": "string",
            "title": "Priority",
            "default": "DS"
          },
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "context_kind": {
            "type": "string",
            "enum": [
              "constructed_demo",
              "project"
            ],
            "title": "Context Kind",
            "default": "project"
          },
          "budget": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "maintenance_method",
          "layer",
          "distress_type",
          "targets"
        ],
        "title": "Scenario"
      },
      "Target": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "operator": {
            "type": "string",
            "enum": [
              ">",
              ">=",
              "<",
              "<=",
              "between"
            ],
            "title": "Operator",
            "default": ">"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "upper": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "enterprise_reference",
              "project_target",
              "demo_assumption"
            ],
            "title": "Source Kind",
            "default": "project_target"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "test_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Method"
          },
          "conditions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conditions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "metric",
          "value"
        ],
        "title": "Target"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VariantInput": {
        "properties": {
          "oil_stone_ratio_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 20.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Oil Stone Ratio Pct"
          },
          "rap_nominal_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rap Nominal Pct"
          },
          "product": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Product"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "note"
        ],
        "title": "VariantInput"
      }
    }
  }
}