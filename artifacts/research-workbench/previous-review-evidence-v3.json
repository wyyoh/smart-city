      "thresholds_authorized": false
    }
  ],
  "highlights": [
    {
      "id": "conflict",
      "title": "要求冲突有范围、有见证",
      "question": "为什么当前没有候选，先复核哪项要求？",
      "case_id": "C5",
      "mechanism": "四态硬约束、冻结候选池、最小冲突与删除见证。",
      "steps": [
        "先看含缺测的完整目录：证据不足。",
        "明确切换完整数值子池：检查四组冲突。",
        "展开删除任一要求后的候选见证和原值。"
      ],
      "boundary": "结论只对声明的需求与候选池成立；最小冲突算法本身不作为原创数学方法。"
    },
    {
      "id": "evidence",
      "title": "材料方案沿证据追到原值",
      "question": "为什么能比较，哪里还不能用于工程？",
      "case_id": "C1",
      "mechanism": "完整材料、方法条件、原单元格与材料版本共同约束比较。",
      "steps": [
        "查看数值满足候选的材料组成与未披露项。",
        "从性能证据追到来源表格和单元格。",
        "检查复核单中的方法、条件和身份缺口。"
      ],
      "boundary": "已知数值满足与工程适用分别检查；未披露改性剂不推断为零。"
    },
    {
      "id": "validation",
      "title": "把未知变成下一步核验行动",
      "question": "还差什么证据，下一步做哪项验证？",
      "case_id": "C2",
      "mechanism": "候选、项目、条件、理由、停止规则绑定同一次决策。",
      "steps": [
        "查看待核验候选及基础验证卡。",
        "微调组成后重新检索，检查父实测失效。",
        "导出复核单并下载真实核验模板。"
      ],
      "boundary": "当前为规则型基础建议，高级主动补测和真实节约收益尚未验证。"
    }
  ],
  "questions": [
    {
      "question": "符合赛题哪一项核心要求？",
      "answer": "对应企业课题一的场景到材料推荐核心流程，覆盖三类结构化场景与五个基准对照案例。详细技术要求和加分项各自标注交付范围。",
      "requirement_ids": [
        "B01",
        "B02",
        "B03"
      ]
    },
    {
      "question": "创新点在哪，是否只是筛表？",
      "answer": "新增价值在要求来源、适用性、范围内冲突与下一步验证的贯通。需求正确给定时，强B1与V2数值可行集一致，未声称筛选准确率提升。",
      "requirement_ids": [
        "T01",
        "T03",
        "T08"
      ]
    },
    {
      "question": "阈值来自规范吗？",
      "answer": "基础参考来自企业工作簿，强化阈值来自明确的团队构造假设。官方公告只登记标准版本；正式项目需要适用条款和批准依据。",
      "requirement_ids": [
        "T01"
      ]
    },
    {
      "question": "为什么84条没有冲突证书，35条却有？",
      "answer": "完整目录包含缺测，不能以未知证明无解。35条是明确选择的完整数值演示子池，只在该范围验证四组包含最小冲突。",
      "requirement_ids": [
        "B03",
        "T08"
      ]
    },
    {
      "question": "AI模型效果怎样？",
      "answer": "四项现有模型外层MAE都未优于均值基线，保留研究展示。当前硬约束结论由记录证据与规则产生，预测不替代实测。",
      "requirement_ids": [
        "T07",
        "X02",
        "X03"
      ]
    },
    {
      "question": "能设计任意新配方吗？",
      "answer": "支持历史目录选材与创建待试验微调版本；新版本不继承父实测。RAP质量基准及可靠代理不足，自动新配方优化延后。",
      "requirement_ids": [
        "T04",
        "X01"
      ]
    },
    {
      "question": "节省多少时间、成本或碳排？",
      "answer": "目前完成AI软件自测，真人用时、价格、碳排及寿命收益待真实数据验证。可核查的是流程审计与未知处理，不能从API时延推算人工节时。",
      "requirement_ids": [
        "B05",
        "X04"
      ]
    },
    {
      "question": "企业能继续使用哪些成果？",
      "answer": "可交接数据结构、规则、接口、代码、模型档案与复现包；需要继续确认材料身份、试验口径、真实需求和企业系统接口。",
      "requirement_ids": [
        "B04",
        "T09",
        "X06"
      ]
    }
  ],
  "scope_note": "状态为团队对本地原型的证据登记，不代表官方评分、专家认可或工程批准。",
