  "sources": [
    {
      "id": "mot-5521-2019",
      "title": "公路沥青路面再生技术规范发布公告",
      "standard": "JTG/T 5521—2019",
      "authority": "交通运输部",
      "type": "推荐性行业标准发布公告",
