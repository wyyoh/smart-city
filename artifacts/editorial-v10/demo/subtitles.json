[
  {
    "start": 0.7190000000409782,
    "end": 8.844000000040978,
    "text": "数智选材：从养护需求出发，比较材料，再继续设计。"
  },
  {
    "start": 10.797000000020489,
    "end": 18.891000000061467,
    "text": "C1 高温重载：同一84条目录中，有2项数值满足构造要求。"
  },
  {
    "start": 19.65700000000652,
    "end": 27.78200000000652,
    "text": "展开要求出处：规则、单位与适用条件随本次决策保留。"
  },
  {
    "start": 29.45299999997951,
    "end": 37.57799999997951,
    "text": "C3 水损害：五种候选均数值可行，而且全部非支配。"
  },
  {
    "start": 38.48499999998603,
    "end": 48.57799999997951,
    "text": "改为残留稳定度优先，首位H变K；五项可行候选保持不变。"
  },
  {
    "start": 49.17200000002049,
    "end": 57.25,
    "text": "原始数值与要求线同时呈现，便于逐项查看候选差异。"
  },
  {
    "start": 58.375,
    "end": 66.48499999998603,
    "text": "保存工程师的取舍理由，后续交接可以回看依据。"
  },
  {
    "start": 68.06299999996554,
    "end": 76.15700000000652,
    "text": "C2 寒冷抗裂：两项候选应变同为2525με，继续比较其他指标。"
  },
  {
    "start": 77.76600000006147,
    "end": 85.875,
    "text": "从准确的R4父配方继续设计，保留原寒冷场景的要求。"
  },
  {
    "start": 87.10999999998603,
    "end": 96.20299999997951,
    "text": "保持组分名义份额，比较油石比4.9%到5.0%的设计假设。"
  },
  {
    "start": 97.59400000004098,
    "end": 106.68799999996554,
    "text": "草案保留原需求和实际改动，新设计性能以待验证状态登记。"
  },
  {
    "start": 108.98499999998603,
    "end": 118.06299999996554,
    "text": "C4 将名义RAP要求从70%提高到75%，预览数值可行1变0。"
  },
  {
    "start": 119.01600000006147,
    "end": 127.125,
    "text": "资源条件与性能要求一起保存，确认后另存本次调整记录。"
  },
  {
    "start": 128.71900000004098,
    "end": 137.7970000000205,
    "text": "C5的84条目录含缺测，先查看待补证据与资料核对方向。"
  },
  {
    "start": 139.14100000006147,
    "end": 148.23499999998603,
    "text": "明确切换35条完整数值子池，得到四组范围内冲突。"
  },
  {
    "start": 149.01600000006147,
    "end": 159.10999999998603,
    "text": "展开冲突子集与删除见证，核对当前范围中的要求组合，再选择后续操作。"
  },
  {
    "start": 159.51600000006147,
    "end": 167.51600000006147,
    "text": "五案同池对照；交付包含源码、接口、保存记录与可重放证据。"
